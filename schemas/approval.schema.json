{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://the-agentic-company.dev/schemas/approval.schema.json",
  "title": "Scoped Human Approval",
  "type": "object",
  "required": ["requestId", "action", "target", "scope", "requestedBy", "expiresAt", "decision"],
  "properties": {
    "requestId": {"type": "string", "minLength": 1},
    "action": {"type": "string", "minLength": 1},
    "target": {"type": "string", "minLength": 1},
    "scope": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "requestedBy": {"type": "string", "minLength": 1},
    "maxCost": {"type": ["number", "null"], "minimum": 0},
    "expiresAt": {"type": "string", "format": "date-time"},
    "decision": {"enum": ["pending", "approved", "rejected", "changes_requested"]},
    "decidedBy": {"type": ["string", "null"]},
    "decidedAt": {"type": ["string", "null"], "format": "date-time"}
  },
  "additionalProperties": false
}
